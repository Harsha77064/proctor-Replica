{
  "name": "oversee",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"node --watch server/index.js\" \"vite\"",
    "dev:lan": "concurrently -k -n api,web -c magenta,cyan \"node --watch server/index.js\" \"cross-env OVERSEE_HTTPS=1 vite --host\"",
    "build": "vite build",
    "start": "node server/index.js",
    "cli": "node server/cli.js",
    "test": "node tests/run.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "lucide-react": "^0.460.0",
    "nodemailer": "^6.9.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=20"
  }
}
